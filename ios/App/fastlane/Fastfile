default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    # Write the App Store Connect API key (.p8) to a file so xcodebuild can
    # authenticate during the ARCHIVE step. gym only auto-passes the API key to
    # the *export* command, not archive, so -allowProvisioningUpdates would have
    # no credentials to create the signing assets — we pass them explicitly via
    # xcargs below. The .p8 arrives base64-encoded (GitHub secrets are 1-line).
    # Write to an absolute temp path — fastlane runs the lane with its working
    # directory set to fastlane/, so a relative path here doubles up
    # (fastlane/fastlane/...). Dir.tmpdir sidesteps all CWD ambiguity.
    require "base64"
    require "tmpdir"
    key_path = File.join(Dir.tmpdir, "asc_api_key.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # Build number = the GitHub Actions run number, so every upload has a
    # unique, always-increasing CFBundleVersion. Info.plist uses
    # $(CURRENT_PROJECT_VERSION) for CFBundleVersion, so we override that build
    # setting (avoids depending on agvtool).
    run_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    # The Xcode project has no DEVELOPMENT_TEAM set (never configured in Xcode),
    # so inject the team + automatic signing + the API-key auth into the archive
    # command. -allowProvisioningUpdates then creates the cert + App Store
    # profile headlessly.
    build_app(
      # SPM project (no CocoaPods/workspace) — build the .xcodeproj directly.
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id,
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Automatic",
        "CURRENT_PROJECT_VERSION=#{run_number}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

# ── Fallback if automatic signing proves flaky in CI ─────────────────────────
# If `-allowProvisioningUpdates` fails to create the distribution cert/profile
# headlessly, switch to Fastlane `match` (deterministic, stored in an encrypted
# repo): run `match appstore` once to seed certs, add MATCH_PASSWORD +
# MATCH_GIT_URL secrets, and replace build_app's automatic signing with the
# match profile. Kept as a note so we don't rebuild from scratch if needed.
