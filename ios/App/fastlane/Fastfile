default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # App Store Connect API key, assembled from CI secrets. Used for both
    # code signing (automatic, via -allowProvisioningUpdates) and the upload.
    # The .p8 is passed base64-encoded so it survives being a GitHub secret.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    # Build number = the GitHub Actions run number, so every upload has a
    # unique, always-increasing CFBundleVersion (TestFlight requires this).
    # Info.plist uses $(CURRENT_PROJECT_VERSION) for CFBundleVersion, so we
    # override that build setting rather than depending on agvtool.
    run_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    build_app(
      # SPM project (no CocoaPods/workspace) — build the .xcodeproj directly.
      # xcodebuild resolves the Swift Package dependencies at build time.
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      # -allowProvisioningUpdates lets xcodebuild create/download the
      # distribution cert + App Store profile automatically using the API key.
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{run_number}",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end

# ── Fallback if automatic signing proves flaky in CI ─────────────────────────
# If `-allowProvisioningUpdates` fails to create the distribution cert/profile
# headlessly, switch to Fastlane `match` (deterministic, stored in an encrypted
# repo): run `match appstore` once to seed certs, add MATCH_PASSWORD +
# MATCH_GIT_URL secrets, and replace build_app's automatic signing with the
# match profile. Kept as a note so we don't rebuild from scratch if needed.
