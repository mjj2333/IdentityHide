<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: catch https://redactid.app/success and /account.
                 android:autoVerify=true tells Play Store + the device to
                 fetch /.well-known/assetlinks.json and verify the SHA256
                 fingerprint matches this app's signing cert. Without that
                 verification the link still works but shows a chooser
                 dialog ("Open with...") on first tap. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="redactid.app" android:pathPrefix="/success" />
                <data android:scheme="https" android:host="redactid.app" android:pathPrefix="/account" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AdMob application ID. SCAFFOLD: this is Google's official TEST app
             ID (serves test ads only). Replace with your real AdMob app ID
             (ca-app-pub-XXXX~YYYY) before shipping real ads. Without this
             meta-data the app crashes on AdMob init. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Advertising ID, required by AdMob. Pairs with the Play Console
         "Advertising ID" declaration being set to Yes. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Camera + photo access. CAMERA is requested at runtime when the
         user taps "Take photo". On Android 13+ the photo picker doesn't
         require READ_MEDIA_IMAGES, so we hold off declaring it here until
         we wire a flow that actually needs broad library access. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
