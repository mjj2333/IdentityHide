# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Large ONNX models (download separately)
public/models/*.onnx

# Large model files
*.pt

# Training data and caches
scripts/coco_cache/
scripts/skin_photos/
scripts/training_masks/

# Claude Code
.claude/

# Local Netlify folder
.netlify

# Test / review artifacts
review-*.png
.playwright-mcp/
test-results/
playwright-report/

# Local scratch / brand assets not part of the build
colors.txt
deno.lock
brand-kit/
qr.txt

# iOS / Capacitor build artifacts. The Xcode project itself (ios/App) is
# checked in so the native shell is reproducible across machines, but the
# generated/per-developer pieces are not.
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/App/build/
ios/DerivedData/
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/App/Podfile.lock

# Fastlane (CI) build artifacts
ios/App/fastlane/report.xml
ios/App/fastlane/Preview.html
ios/App/fastlane/test_output/
ios/App/vendor/bundle/
ios/App/*.ipa
ios/App/*.dSYM.zip

# Android / Capacitor build artifacts. Same idea as iOS: the Gradle project
# is checked in, but generated and machine-specific pieces are not.
android/app/build/
android/app/src/main/assets/public/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/app/release/
android/key.properties
android/*.keystore
android/*.jks

# Capacitor live-reload backup. The cap-livereload.mjs script writes this
# while it's running and removes it on exit, but a crashed run can leave it
# behind — keep it out of git either way.
capacitor.config.json.bak
