# Normalize line endings so the Windows dev machine and the macOS iOS-build
# machine don't produce noisy CRLF/LF diffs against each other.
# Text files are stored as LF in the repo and checked out as LF everywhere.
* text=auto eol=lf

# Windows batch scripts must stay CRLF or cmd.exe can misbehave.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Unix shell scripts (e.g. gradlew) must stay LF.
*.sh   text eol=lf

# Treat these as binary so git never rewrites their bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.onnx  binary
*.pdf   binary
*.mp4   binary
*.mov   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.jks   binary
*.keystore binary
*.zip   binary
*.7z    binary
